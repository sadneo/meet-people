# Copy to .env.android. `pnpm build:android` reads it (vite --mode android).
# Everything here is public: it ends up inside the APK. Never put SUPABASE_SERVICE_ROLE_KEY here.

# --- Hosted backend (release / real device) ---
# Your Firebase Hosting site (rewrites /api/** to Cloud Run) or the Cloud Run URL. No trailing slash.
VITE_API_BASE_URL=https://YOUR-SITE.web.app
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# --- Local backend (Android emulator only) ---
# 10.0.2.2 is the emulator's alias for your computer. When these are http://, `cap sync`
# automatically enables cleartext traffic (see capacitor.config.ts); https:// stays locked down.
# VITE_API_BASE_URL=http://10.0.2.2:3001
# VITE_SUPABASE_URL=http://10.0.2.2:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<from `pnpm env:local`>
