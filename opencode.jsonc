{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "bash": {
      "npm": "deny",
      "npm *": "deny",
      "npx": "deny",
      "npx *": "deny"
    }
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "@playwright/mcp@latest",
        "--executable-path",
        "/home/aidan/.nix-profile/bin/chromium",
        "--headless"
      ],
      "enabled": true
    }
  }
}
