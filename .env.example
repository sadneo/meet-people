# Public browser configuration. Generate local values with `pnpm env:local`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Do not set this in Vite-prefixed variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Comma-separated extra browser origins allowed by the API (the Android WebView
# origins https://localhost and capacitor://localhost are always allowed).
# CORS_ORIGINS=https://YOUR-SITE.web.app

# Android builds read VITE_API_BASE_URL from .env.android; see .env.android.example.

# Push notifications (server-only; used by api/push-dispatcher-main.ts). See docs/PUSH-NOTIFICATIONS.md.
# PUSH_DISPATCH_ENABLED=true
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON=   # the whole service-account key JSON on one line. Never commit it.
# PUSH_DISPATCH_INTERVAL_MS=5000   # optional: keep polling instead of running once
