# Public browser configuration. Generate local values with `pnpm env:local`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Do not set this in Vite-prefixed variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keep off until the reviewed Dating SQL prerequisites and new migration pass
# disposable integration/concurrency checks. Never put this in a VITE variable.
DATING_RULES_ENABLED=false
FRIENDS_RULES_ENABLED=false
ACTIVE_FRIENDS_ENABLED=false
