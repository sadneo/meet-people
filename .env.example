# The only env file. Copy to .env (gitignored) and fill in what you need; everything is optional.
# Local Supabase URLs and keys are NOT set here: pnpm dev reads them from this worktree's running stack.
# Public hosted values (URLs, publishable keys) are committed in shared/targets.json.
# A new worktree copies .env from the main checkout the first time you run pnpm dev.

# --- Local development ---
# Google sign-in on local Supabase (supabase/config.toml reads these). Without them "Continue with Google" fails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local Edge Functions (pnpm dev runs `supabase functions serve --env-file .env`).
TICKETMASTER_API_KEY=
INGEST_TOKEN=
# Interest embeddings (embed-interest function). Not enough on their own locally yet: the local database also
# needs the pebble_project_url and pebble_embed_secret Vault secrets, which nothing sets up, so it reports
# "Embedding service is not configured" until that exists.
# GEMINI_API_KEY=
# EMBED_SHARED_SECRET=

# Google location picker. The browser key is public: restrict its APIs and referrers.
# VITE_GOOGLE_MAPS_API_KEY=
# Server-only Places/Geocoding key. Never prefix with VITE_.
# GOOGLE_MAPS_SERVER_API_KEY=
# Alternative to the server key: call Places with your gcloud credentials, billed to this GCP project.
# GOOGLE_MAPS_OAUTH_PROJECT=
# 32 random bytes as 64 hex characters; install the same key in the DB. See docs/google-search-locations.md.
# SEARCH_LOCATION_SIGNING_KEY=
# GOOGLE_MAPS_STORAGE_APPROVED=false
# GOOGLE_MAPS_REQUESTS_PER_DAY=2000

# Extra browser origins the API accepts, comma-separated (e.g. opening the app from a phone on your LAN).
# The Android WebView origins https://localhost and capacitor://localhost are always allowed.
# CORS_ORIGINS=http://192.168.1.20:3000

# Push notifications (api/push-dispatcher-main.ts). See docs/PUSH-NOTIFICATIONS.md.
# PUSH_DISPATCH_ENABLED=true
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON=   # the whole service-account key JSON on one line
# PUSH_DISPATCH_INTERVAL_MS=5000   # optional: keep polling instead of running once

# --- Hosted projects (prefixed so a command can only reach the project you name with --target) ---
# Used by: pnpm dev --remote, pnpm test:hosted <url> --account|--product|--messaging.
# SANDBOX_SUPABASE_SERVICE_ROLE_KEY=
# PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
