# Public browser configuration. Generate local values with `pnpm env:local`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Do not set this in Vite-prefixed variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google location picker. Browser key is public: restrict its APIs and referrers.
VITE_GOOGLE_MAPS_API_KEY=
# Server-only Places/Geocoding key. Populate and uncomment; never prefix with VITE_.
# GOOGLE_MAPS_SERVER_API_KEY=
# 32 random bytes encoded as 64 hex characters; install the same key in the DB.
# See docs/google-search-locations.md before activation.
# SEARCH_LOCATION_SIGNING_KEY=
GOOGLE_MAPS_STORAGE_APPROVED=false
GOOGLE_MAPS_REQUESTS_PER_DAY=2000
