{
  "name": "meet-people",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:mobile && pnpm build:api",
    "build:web": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:api": "tsc -p tsconfig.api.json",
    "android": "node scripts/android.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vite.config.ts && node --test tests/doctor.test.mjs tests/scripts/*.test.mjs tests/deployment.test.mjs tests/production-migration-audit.test.mjs tests/production-recovery.test.mjs tools/qa-real-users/*.test.mjs && node src/alt/tests/account-ui.check.cjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:hosted": "node scripts/test-hosted.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "supabase": "node scripts/supabase.mjs",
    "db:types": "node scripts/db-types.mjs",
    "demo": "node scripts/demo.mjs",
    "hosting:configure": "node --env-file-if-exists=.env.hosting.local scripts/configure-hosted.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.105.0",
    "cors": "^2.8.6",
    "express": "^5.2.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/google.maps": "^3.66.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "28.0.0",
    "supabase": "2.117.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0",
    "vitest": "5.0.1"
  }
}
