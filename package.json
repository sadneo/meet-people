{
  "name": "meet-people",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "vite",
    "dev:alt": "node src/alt/serve.mjs",
    "dev:api": "tsx watch --env-file-if-exists=.env.local api/server.ts",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:api",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vite.config.ts",
    "test:alt": "node src/alt/tests/account-ui.check.cjs",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:browser:built": "pnpm build && sh scripts/test-built.sh",
    "test:integration": "node --test tests/integration/local-services.test.mjs",
    "test:integration:auth": "node tests/integration/local/test-local-auth.mjs",
    "test:integration:schema": "node tests/integration/local/test-product-schema.mjs",
    "test:integration:browser": "playwright test --config playwright.integration.config.ts",
    "test:hosted": "node tests/integration/hosted/test-hosted.mjs",
    "test:hosted:account": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=\"$(command -v chromium || true)\" node --env-file-if-exists=.env.hosting.local tests/integration/hosted/test-hosted-account.mjs",
    "test:hosted:product": "node --env-file-if-exists=.env.hosting.local tests/integration/hosted/test-hosted-product.mjs",
    "hosting:configure": "node --env-file-if-exists=.env.hosting.local scripts/configure-hosted.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build",
    "start:api": "node dist/api/api/server.js",
    "start:worker": "node dist/api/api/event-group-worker-main.js",
    "preview": "vite preview",
    "supabase:start": "sh scripts/supabase.sh start",
    "supabase:stop": "sh scripts/supabase.sh stop",
    "supabase:reset": "sh scripts/supabase.sh db reset",
    "supabase:types": "mkdir -p src/types && sh scripts/supabase.sh gen types typescript --local > src/types/database.ts",
    "supabase:check": "pnpm supabase:reset && pnpm supabase:types && git diff --exit-code -- src/types/database.ts",
    "supabase:functions:serve": "sh scripts/supabase.sh functions serve ingest-ticketmaster --env-file supabase/.env",
    "supabase:functions:serve:sbengaged": "sh scripts/supabase.sh functions serve ingest-sbengaged --env-file supabase/.env",
    "env:local": "node scripts/write-local-env.mjs",
    "build:android": "vite build --mode android && cap sync android",
    "android": "pnpm build:android && cap open android",
    "demo:queue": "tsx scripts/queue-local-demo.ts",
    "demo:seed": "tsx scripts/seed-local-demo.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.116.0",
    "cors": "^2.8.6",
    "express": "^5.2.0",
    "express-rate-limit": "^8.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "28.0.0",
    "supabase": "2.117.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0",
    "vitest": "5.0.1"
  }
}
